# npm policy for this package root. MUST exist here as its own file: npm's
# project config is the .npmrc beside the package.json it is installing, and it
# does NOT walk up to the repo root. Without this file, `npm ci` in this
# directory runs with ignore-scripts=false no matter what the root .npmrc says.
#
# WHY: a compromised package can ship arbitrary code in preinstall / install /
# postinstall / prepare. Disabling script execution at install time means a
# backdoor targeting the install hook never runs on this machine or on a build
# VM.
#
# WHAT BREAKS: packages that compile or fetch a binary in a lifecycle hook.
# Run those explicitly after install (e.g. `npx cmake-js build --release` for
# noRDP, `npm rebuild <pkg>`) — never by relaxing this flag.
#
# OVERRIDE: treat any "must remove ignore-scripts" pressure as a request for a
# security review, not a config change.
ignore-scripts=true
